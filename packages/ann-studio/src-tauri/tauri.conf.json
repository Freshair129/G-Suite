{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G-AnnStudio",
  "version": "0.1.0",
  "identifier": "com.gmaiden.ann-studio",
  "build": {
    "beforeBuildCommand": "node ../../tools/prepare-ann-media.mjs && node ../../tools/build-ann-frontend.mjs",
    "beforeDevCommand": "pnpm -C src dev",
    "devUrl": "http://localhost:5174",
    "frontendDist": "gen/web"
  },
  "app": {
    "windows": [
      {
        "title": "G-AnnStudio — Announcer Pack Editor",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; media-src 'self' blob: asset: http://asset.localhost; img-src 'self' blob: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "bundle": {
    "fileAssociations": [
      {
        "ext": [
          "gann"
        ],
        "name": "G-Ann Announcer Package",
        "description": "Announcer audio, banner motion and configuration",
        "role": "Viewer",
        "mimeType": "application/vnd.gann.package+zip"
      },
      {
        "ext": [
          "ann"
        ],
        "name": "G-AnnStudio Editable Project",
        "description": "Portable announcer project with managed media",
        "role": "Editor",
        "mimeType": "application/vnd.gann.project+zip"
      }
    ],
    "resources": {
      "resources/media-tools/": "media-tools/"
    }
  }
}
