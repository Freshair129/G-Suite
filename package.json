{
  "name": "g-suite",
  "version": "0.1.0",
  "description": "G-Suite \u2014 monorepo of developer tools for the G-Maiden ecosystem",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "ann-studio:dev": "pnpm -C packages/ann-studio dev",
    "ann-studio:build": "pnpm -C packages/ann-studio build",
    "3d-studio:dev": "pnpm -C packages/3d-studio tauri dev",
    "3d-studio:build": "pnpm -C packages/3d-studio build:desktop",
    "3d-studio:build:fe": "pnpm -C packages/3d-studio build:fe",
    "3d-studio:test": "pnpm -C packages/3d-studio test:workspace"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "packageExtensions": {
      "lucide-react@0.456.0": {
        "peerDependencies": {
          "@types/react": "^18.2.0"
        }
      }
    }
  }
}
