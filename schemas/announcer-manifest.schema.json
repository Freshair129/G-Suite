{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Freshair129/G-Suite/schemas/announcer-manifest.schema.json",
  "title": "G-Maiden Announcer Manifest",
  "description": "Contract between G-AnnStudio (producer) and G-Maiden (consumer). Maps audio clips to in-game Dota 2 events.",
  "type": "object",
  "required": ["version", "pack_name", "clips"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Manifest schema version (semver-ish).",
      "examples": ["1.0"]
    },
    "pack_name": {
      "type": "string",
      "description": "Display name of the announcer pack."
    },
    "authorGid": {
      "type": "string",
      "pattern": "^G-[FBP][23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6,10}$",
      "description": "Optional GID of the creator (unsigned display metadata, not identity proof)"
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "event", "duration"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable unique id for the clip."
          },
          "name": {
            "type": "string",
            "description": "Human-friendly clip name."
          },
          "path": {
            "type": "string",
            "description": "Relative path to the WAV file, next to this manifest."
          },
          "event": {
            "type": "string",
            "description": "Dota 2 event id this clip is triggered by (see packages/ann-studio dota-events)."
          },
          "duration": {
            "type": "number",
            "description": "Clip duration in seconds."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
